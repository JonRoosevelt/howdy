{
  "manifest_version": 3,
  "name": "Howdy",
  "version": "0.3.0",
  "description": "Morning Brief, reports and chat over your calendar, inbox, Slack, Jira and browsing history. Bring your own LLM.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "history",
    "storage",
    "alarms",
    "cookies",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://*.slack.com/*",
    "https://*.atlassian.net/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "slack-session.js"
      ]
    },
    {
      "matches": [
        "https://mail.google.com/mail/*"
      ],
      "js": [
        "gmail-frame.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Howdy",
    "default_popup": "app.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "chat.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
